# ===== 阿里云百炼（DashScope）=====
# 在 https://bailian.console.aliyun.com/ 创建 API Key
DASHSCOPE_API_KEY=
# 接口主机。默认使用通用域名；如需使用业务空间专属域名，填写形如
# {WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_HOST=dashscope.aliyuncs.com

# 模型名（以百炼控制台“模型广场”为准，可随时修改）
LLM_MODEL=qwen3.7-plus
LLM_FAST_MODEL=qwen3.8-flash
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
ASR_MODEL=fun-asr-realtime
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanrou_v3
TTS_RATE=0.85
IMAGE_MODEL=wan2.6-t2i

# ===== 全景图服务：wanx（默认）或 skybox =====
PANORAMA_PROVIDER=wanx
BLOCKADE_API_KEY=
BLOCKADE_STYLE_ID=

# ===== 深度估计：local_onnx（默认）/ provider（使用全景服务自带深度图）/ geometric =====
DEPTH_PROVIDER=local_onnx
DEPTH_ONNX_PATH=models/depth_anything_v2_small.onnx

# ===== 声音素材 =====
FREESOUND_API_KEY=
# 可选：文生音效（ElevenLabs）
ELEVENLABS_API_KEY=

# ===== 可选：3D 生成（默认关闭）=====
MODEL3D_PROVIDER=off
TRIPO_API_KEY=
MESHY_API_KEY=

# ===== 运行 =====
# 没有 Key 时，强制使用本地演示实现（不调用任何云端服务）
DEMO_MODE=false
